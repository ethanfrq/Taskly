# Copy to .env.local and fill in. Every variable is optional for local development.

# Postgres connection string (Neon on Vercel). Unset: local PGlite database in .data/pglite.
DATABASE_URL=

# Public URL of this instance. Unset: http://localhost:3000 locally, the Vercel URL in production.
BETTER_AUTH_URL=

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email codes. Unset in development: codes are printed in the server console.
# Required in production (Taskly won't print sign-in codes into production logs).
RESEND_API_KEY=
EMAIL_FROM="Taskly <taskly@your-domain.com>"

# Web Push. Generate with: npx web-push generate-vapid-keys
# Unset locally: keys are generated once in .data/vapid.json.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@your-domain.com"

# Set to 1 to register the service worker during `npm run dev` (to test push locally).
NEXT_PUBLIC_SW_DEV=

# Exact-time reminders through Upstash QStash (Vercel Marketplace). Unset: see CRON_SECRET.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Without QStash: call GET /api/reminders/sweep every minute with
# "Authorization: Bearer $CRON_SECRET" (Vercel Pro cron, or any external cron).
CRON_SECRET=

# Long-running server (`next start` on a VPS): set to 1 to send reminders from the server itself.
TASKLY_INTERNAL_SCHEDULER=

# A personal instance: only these addresses (comma-separated) can sign in. Unset: anyone.
TASKLY_ALLOWED_EMAILS=

# Behind a CDN plus a reverse proxy: their IPs or CIDR ranges, comma-separated, so rate limits
# see each visitor's IP. Not needed on Vercel or behind a single Caddy.
TASKLY_TRUSTED_PROXIES=
